<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title @text="title + ' | WWO | a.ndr.ooo'"></title>

        <link rel="stylesheet" href="../css/fonts.css" />
        <link rel="stylesheet" href="../css/weird.css" />

        <link
            rel="preload"
            as="fetch"
            :href="'https://octothorp.es/?uri=https://a.ndr.ooo' + page.url"
        />
        <link rel="octo:octothorpes" href="weirdweboctober" />
        <link rel="octo:octothorpes" :href="title" />

        <meta webc:if="description" name="description" :content="description" />

        <meta property="og:type" :content="website" />
        <meta property="og:url" :content="'https://a.ndr.ooo' + page.url" />
        <meta
            property="og:title"
            :content="title + ' | Weird Web October | a.ndr.ooo'"
        />
        <meta
            webc:if="description"
            property="og:description"
            :content="description"
        />
        <meta
            webc:if="preview"
            property="og:image"
            :content="'https://a.ndr.ooo/previews/' + preview"
        />

        <style webc:keep @raw="getBundle('css')"></style>

        <meta webc:if="description" name="description" :content="description" />
    </head>
    <body>
        <div class="content-box">
            <header>
                <nav>
                    <ul>
                        <li>
                            <a
                                webc:if="getPrevWWOPage(title, wwo2026, collections.wwo)"
                                :href="getPrevWWOPage(title, wwo2026, collections.wwo).url"
                                class="button"
                            >
                                &larr;
                                <span
                                    @text="getPrevWWOPage(title, wwo2026, collections.wwo).data.title"
                                ></span>
                            </a>
                        </li>
                        <li>
                            <span @text="title"></span> |
                            <a href="/weird">Weird Web October</a>
                            <span @text="' ' + year + ' | '"></span>
                            <a href="/">a.ndr.ooo</a>
                        </li>
                        <li>
                            <a
                                webc:if="getNextWWOPage(title, wwo2026, collections.wwo)"
                                :href="getNextWWOPage(title, wwo2026, collections.wwo).url"
                                class="button"
                            >
                                <span
                                    @text="getNextWWOPage(title, wwo2026, collections.wwo).data.title"
                                ></span>
                                &rarr;
                            </a>
                        </li>
                    </ul>
                </nav>
            </header>
            <main @raw="content"></main>
        </div>
        <script type="module" webc:keep @raw="getBundle('js')"></script>
    </body>
</html>
